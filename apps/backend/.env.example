# Variables de entorno del backend. Copiar a .env y completar los valores
# (.env está en .gitignore: nunca se commitea). En producción van como
# secrets de Fly.io. Detalle en docs/backend-y-colas.md.

# Supabase: Project Settings → API (URL) y API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secreta: solo el backend la usa. Nunca en el mobile ni en el repo.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Redis de Upstash para las colas de BullMQ (la misma instancia en desarrollo
# y producción). Upstash → base de datos → "Connect" → URL que empieza con
# rediss:// (con dos "s": TLS).
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Sentry (errores de producción). Sin SENTRY_DSN, Sentry queda apagado: en
# desarrollo se deja vacía, salvo para probarlo. El DSN está en Sentry →
# proyecto utalk-backend → Settings → Client Keys.
# SENTRY_DSN=https://<clave>@o<org>.ingest.us.sentry.io/<proyecto>
# Opcional. Separa los errores por entorno en Sentry (por defecto development).
# SENTRY_ENVIRONMENT=production

# Opcional. Puerto HTTP (por defecto 3000).
# PORT=3000

# Opcional en desarrollo, obligatoria en producción si hay versión web.
# Orígenes web que pueden llamar a la API, separados por coma. Sin la
# variable solo se permite Expo web en desarrollo (http://localhost:8081).
# CORS_ORIGINS=https://utalk.app
