# Variables de entorno del mobile. Copiar a .env y completar los valores
# (.env está en .gitignore).
#
# Todo lo que empieza con EXPO_PUBLIC_ se incluye en la app que se instala
# en el celular: cualquiera puede leerlo. Acá NUNCA va una clave secreta
# (la SUPABASE_SECRET_KEY es solo del backend).

# Supabase: Project Settings → API (URL) y API Keys (la publishable, no la secreta).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL del backend. Con localhost alcanza también para probar en un celular
# con Expo Go: en desarrollo, la app reemplaza localhost por la IP del
# computador que sirve la app (ver src/lib/apiUrl.ts). El celular y el
# computador tienen que estar en la misma red WiFi.
EXPO_PUBLIC_API_URL=http://localhost:3000
