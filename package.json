{
  "name": "utalk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "mobile:web": "npm run web -w apps/mobile",
    "backend": "npm run start:dev -w apps/backend",
    "backend:build": "npm run build -w apps/backend",
    "backend:test": "npm run test -w apps/backend",
    "lint": "npm run lint -w apps/backend && npm run lint -w apps/mobile"
  }
}
