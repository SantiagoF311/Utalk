# dependencies (root + any workspace: apps/*, packages/*)
node_modules/

# npm workspaces usa un único package-lock.json, el de la raíz. Uno dentro de
# un workspace solo aparece si alguien corrió npm install ahí (ver CLAUDE.md).
apps/*/package-lock.json
packages/*/package-lock.json

# env files
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# logs
*.log
npm-debug.log*

# build output
/dist
/build
*.tsbuildinfo

# supabase cli
supabase/.temp/
